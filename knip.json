{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/app/**/{page,layout,not-found,error,loading,template,default}.tsx",
    "scripts/*.{ts,mjs}",
    "e2e/**/*.spec.ts",
    "**/*.test.ts",
    "src/lib/design/tokens.ts!"
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.{ts,mjs}", "e2e/**/*.ts"],
  "ignore": ["src/components/ui/**"],
  "ignoreDependencies": [
    "tw-animate-css",
    "tailwindcss",
    "eslint-config-next",
    "class-variance-authority",
    "shadcn"
  ],
  "tags": ["-@reserved"],
  "drizzle": false,
  "rules": {
    "files": "error",
    "exports": "error",
    "types": "error",
    "duplicates": "error",
    "dependencies": "error",
    "unlisted": "error",
    "binaries": "warn",
    "enumMembers": "off"
  }
}
